# Copy to .env.local for local development, or add these in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values: this repository is public.

# Public address of the site (used for links and social previews)
NEXT_PUBLIC_SITE_URL=https://pahadofficial.vercel.app

# --- Login security -------------------------------------------------
# A long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- First Super Admin ----------------------------------------------
# Created automatically the first time the site starts with an empty database.
# Sign in with these, then change the password under My Account.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# --- Database: Postgres via Neon (Vercel → Storage → Neon) ------------
# Vercel fills this in automatically when you connect Neon to the project.
# Leave empty locally to use the built-in file database (.data/pahad-db.json).
DATABASE_URL=

# --- File uploads: Cloudflare R2 --------------------------------------
# Leave empty locally to store uploads in public/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket, e.g. https://media.yourdomain.org or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
