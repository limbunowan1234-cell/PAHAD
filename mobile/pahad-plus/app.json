{
  "expo": {
    "name": "PAHAD+",
    "slug": "pahad-plus",
    "scheme": "pahadplus",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#11181B",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#11181B"
    },
    "android": {
      "package": "org.pahad.plus",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11181B"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pahad.org",
              "pathPrefix": "/plus"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "org.pahad.plus",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "PAHAD+ uses your photos so you can add a picture to your post.",
          "cameraPermission": "PAHAD+ uses the camera to take a photo for your post.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PAHAD+ uses the camera to scan E-Pass QR codes at the gate.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-image",
      "expo-video",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "https://pahad.org"
    }
  }
}
